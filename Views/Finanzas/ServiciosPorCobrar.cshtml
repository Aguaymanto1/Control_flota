@model IEnumerable<Control_flota.Models.Operaciones.Orden>

@{
    ViewData["Title"] = "Servicios por Cobrar";
}

<link rel="stylesheet" href="/css/finanzas-servicios.css" />

<div class="header-finanzas">
    <div class="header-title">
        <h1>💰 Servicios por Cobrar</h1>
    </div>
    <div class="badge-rol">Administrador de Finanzas</div>
</div>

<!-- Mensaje flash -->
<div id="flashMensaje" style="display:none;position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:2100;min-width:320px;max-width:90%;padding:12px;border-radius:8px;font-weight:600;background:#ecfdf5;color:#065f46;border:1px solid #bbf7d0;box-shadow:0 6px 18px rgba(2,6,23,0.2)"></div>

<!-- Estadísticas -->
<div class="stats-row">
    <div class="stat-card">
        <div class="stat-label">📦 Total de Viajes Completados</div>
        <div class="stat-value">@ViewBag.TotalViajesCompletados</div>
    </div>
</div>

<div class="seccion-servicios">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-state-icon">📋</div>
            <div class="empty-state-text">
                <p>No hay viajes completados aún para facturar.</p>
            </div>
        </div>
    }
    else
    {
        <h3 class="seccion-titulo">Viajes Completados</h3>
        
        @foreach (var viaje in Model)
        {
            var montoBase = viaje.SolicitudServicio?.Monto ?? viaje.Gastos?.Sum(g => g.Monto) ?? 0m;
            // Determinar estado de factura si existe (esto se actualizará con JavaScript)
            <div class="servicio-item">
                <div style="flex: 1;">
                    <div class="servicio-item-cliente">@viaje.Cliente?.Nombre</div>
                    <div class="servicio-item-detalles">
                        <strong>Código:</strong> @viaje.Codigo | 
                        <strong>Ruta:</strong> @viaje.Origen → @viaje.Destino
                    </div>
                    <div class="servicio-item-detalles">
                        📅 @viaje.FechaEmision.ToString("dd/MM/yyyy")
                    </div>
                    <div class="servicio-item-total">
                        Total base: S/ @montoBase.ToString("F2")
                    </div>
                </div>
                <div class="servicio-actions">
                    <button class="btn-generar-factura" 
                            data-orden-id="@viaje.Id"
                            onclick="abrirFormularioFactura(@viaje.Id, '@viaje.Cliente?.Nombre', '@viaje.Codigo', @montoBase.ToString("F2").Replace(",", "."))">
                        📄 Generar Factura
                    </button>
                    <span class="estado-badge estado-sin-facturar" id="estado-@viaje.Id">Sin facturar</span>
                </div>
            </div>
        }
    }
</div>

<!-- Modal para el formulario de factura -->
<div class="modal-factura" id="modalFormularioFactura">
    <div class="modal-content-factura" style="max-width: 500px;">
        <div class="modal-header-factura">
            <h2>📄 Generar Factura</h2>
            <button class="btn-cerrar-modal" onclick="cerrarFormularioFactura()">&times;</button>
        </div>
        <div class="modal-body-factura">
            <form id="formularioFactura">
                <input type="hidden" id="facturaOrdenId" />
                
                <div class="form-grupo">
                    <label>Cliente</label>
                    <input type="text" id="facturaCliente" class="form-input" readonly disabled />
                </div>
                
                <div class="form-grupo">
                    <label>Código de Servicio</label>
                    <input type="text" id="facturaCodigo" class="form-input" readonly disabled />
                </div>
                
                <div class="form-grupo">
                    <label>Monto Base (S/)</label>
                    <input type="text" id="facturaMontoBase" class="form-input" readonly disabled />
                </div>
                
                <div class="form-grupo">
                    <label>Fecha de Vencimiento *</label>
                    <input type="date" id="facturaFechaVencimiento" class="form-input" required min="@DateTime.Now.ToString("yyyy-MM-dd")"/>
                </div>
                
                <div class="form-grupo">
                    <label>Sobrecostos</label>
                    <div id="listaSobrecostos">
                        <div class="sobrecosto-item">
                            <input type="text" placeholder="Concepto" class="sobrecosto-concepto" style="width: 60%;" />
                            <input type="number" placeholder="Monto" class="sobrecosto-monto" style="width: 35%;" step="0.01" />
                            <button type="button" class="btn-eliminar-sobrecosto" onclick="eliminarSobrecosto(this)" style="display: none;">✕</button>
                        </div>
                    </div>
                    <button type="button" class="btn-agregar-sobrecosto" onclick="agregarSobrecosto()">+ Agregar sobrecosto</button>
                </div>
                
                <div class="form-grupo total-section">
                    <label>Total a Facturar (S/)</label>
                    <div class="total-calculado" id="totalFactura">S/ 0.00</div>
                </div>
            </form>
        </div>
        <div class="modal-footer-factura">
            <button class="btn-guardar" onclick="guardarYEmitirFactura()">💾 Emitir Factura</button>
            <button class="btn-modal-cerrar" onclick="cerrarFormularioFactura()">Cancelar</button>
        </div>
    </div>
</div>

<!-- Modal para vista previa de factura -->
<div class="modal-factura" id="modalVistaFactura">
    <div class="modal-content-factura">
        <div class="modal-header-factura">
            <h2>📄 Vista Previa de Factura</h2>
            <button class="btn-cerrar-modal" onclick="cerrarVistaFactura()">&times;</button>
        </div>
        <div class="modal-body-factura" id="contenidoFactura"></div>
        <div class="modal-footer-factura">
            <button class="btn-descargar" onclick="descargarFacturaPdf()">📥 Descargar Factura</button>
            <button class="btn-guardar" onclick="guardarYEmitirFactura()">💾 Emitir Factura</button>
            <button class="btn-modal-cerrar" onclick="cerrarVistaFactura()">Cerrar</button>
        </div>
    </div>
</div>

<script src="/js/finanzas-servicios.js"></script>