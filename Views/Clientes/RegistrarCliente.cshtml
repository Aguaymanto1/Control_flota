@model Control_flota.Models.Operaciones.Cliente
@{ ViewData["Title"] = "Registrar Cliente"; }

<h2>Registrar Nuevo Cliente</h2>

<form asp-action="RegistrarCliente" method="post" style="max-width:500px;">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="mb-3">
        <label asp-for="Ruc" class="form-label">RUC <span class="text-danger">*</span></label>
        <input asp-for="Ruc" class="form-control" maxlength="11" placeholder="11 dígitos" />
        <span asp-validation-for="Ruc" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label">Razón Social <span class="text-danger">*</span></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Direccion" class="form-label">Dirección <span class="text-danger">*</span></label>
        <input asp-for="Direccion" class="form-control" />
        <span asp-validation-for="Direccion" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Telefono" class="form-label">Teléfono <span class="text-danger">*</span></label>
        <input asp-for="Telefono" class="form-control" />
        <span asp-validation-for="Telefono" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Correo" class="form-label">Correo <span class="text-danger">*</span></label>
        <input asp-for="Correo" type="email" class="form-control" />
        <span asp-validation-for="Correo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="PersonaContacto" class="form-label">Persona de Contacto <span class="text-muted">(opcional)</span></label>
        <input asp-for="PersonaContacto" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Registrar Cliente</button>
    <a href="@Url.Action("Index")" class="btn btn-secondary ms-2">Cancelar</a>
</form>