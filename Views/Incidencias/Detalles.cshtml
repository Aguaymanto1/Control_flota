    @model IEnumerable<Control_flota.Models.Operaciones.IncidenciaRuta>

@{
    ViewData["Title"] = "Detalle de Incidencias";
}

<h2>Detalle de Incidencias</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Fecha</th>
            <th>Tipo</th>
            <th>Descripción</th>
            <th>Ubicación</th>
            <th>Estado</th>
        </tr>
    </thead>

    <tbody>
    @foreach(var item in Model)
    {
        <tr>
            <td>@item.FechaReporte</td>
            <td>@item.TipoIncidencia</td>
            <td>@item.Descripcion</td>
            <td>@item.Latitud,item.Longitud</td>
            
            <td>@item.Estado</td>
        </tr>
    }
    </tbody>
</table>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">
        Atrás
    </a>

    <form asp-action="Atender"
          method="post"
          style="display:inline;">
        @Html.AntiForgeryToken()

        <input type="hidden"
               name="conductorId"
               value="@Model.First().ConductorId" />

        <input type="hidden"
               name="ordenId"
               value="@Model.First().OrdenId" />

        <button type="submit"
                class="btn btn-success">
            Aceptar
        </button>
    </form>
</div>
</a>