@model IEnumerable<Control_flota.Models.Operaciones.IncidenciaRuta>

@{
    ViewData["Title"] = "Detalle de Incidencias";
    var primera = Model.First();
}

<div style="margin-bottom:24px;">
    <h2 style="font-size:1.75rem; font-weight:700; color:#0f172a; margin:0;">Detalle de Incidencias</h2>
    <p style="color:#64748b; margin:4px 0 0; font-size:0.9rem;">
        Conductor: <strong>@primera.Conductor?.Nombres @primera.Conductor?.Apellidos</strong>
        &nbsp;·&nbsp; Orden: <strong>@primera.Orden?.Codigo</strong>
    </p>
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div style="background:white; border:1px solid #e2e8f0; border-radius:12px; overflow:hidden; margin-bottom:24px;">
    <table class="table" style="margin:0;">
        <thead>
            <tr style="background:#f8fafc;">
                <th style="padding:13px 20px; color:#475569; font-size:0.75rem; font-weight:600; text-transform:uppercase; border-top:none; border-bottom:1px solid #e2e8f0;">Fecha</th>
                <th style="padding:13px 20px; color:#475569; font-size:0.75rem; font-weight:600; text-transform:uppercase; border-top:none; border-bottom:1px solid #e2e8f0;">Tipo</th>
                <th style="padding:13px 20px; color:#475569; font-size:0.75rem; font-weight:600; text-transform:uppercase; border-top:none; border-bottom:1px solid #e2e8f0;">Descripción</th>
                <th style="padding:13px 20px; color:#475569; font-size:0.75rem; font-weight:600; text-transform:uppercase; border-top:none; border-bottom:1px solid #e2e8f0;">Ubicación</th>
                <th style="padding:13px 20px; color:#475569; font-size:0.75rem; font-weight:600; text-transform:uppercase; border-top:none; border-bottom:1px solid #e2e8f0;">Estado</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr style="border-bottom:1px solid #f1f5f9;">
                <td style="padding:14px 20px; font-size:0.875rem;">@item.FechaReporte.ToString("dd/MM/yyyy HH:mm")</td>
                <td style="padding:14px 20px; font-size:0.875rem;">@item.TipoIncidencia</td>
                <td style="padding:14px 20px; font-size:0.875rem;">@item.Descripcion</td>
                <td style="padding:14px 20px; font-size:0.875rem;">
                    @if (!string.IsNullOrEmpty(item.UbicacionTexto))
                    {
                        <span><i class="fa-solid fa-location-dot me-1" style="color:#2563eb;"></i>@item.UbicacionTexto</span>
                    }
                    else if (item.Latitud.HasValue && item.Longitud.HasValue)
                    {
                        <span style="color:#64748b; font-size:0.8rem;">@item.Latitud?.ToString("F4"), @item.Longitud?.ToString("F4")</span>
                    }
                    else
                    {
                        <span style="color:#94a3b8;">Sin ubicación</span>
                    }
                </td>
                <td style="padding:14px 20px;">
                    @if (item.Estado == "Pendiente")
                    {
                        <span style="background:#fff7ed; color:#ea580c; padding:4px 12px; border-radius:20px; font-size:0.75rem; font-weight:600;">Pendiente</span>
                    }
                    else
                    {
                        <span style="background:#f0fdf4; color:#16a34a; padding:4px 12px; border-radius:20px; font-size:0.75rem; font-weight:600;">Atendido</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div style="display:flex; gap:10px;">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i> Atrás
    </a>

    @if (Model.Any(i => i.Estado == "Pendiente"))
    {
        <form asp-action="Atender" method="post" style="display:inline;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="conductorId" value="@primera.ConductorId" />
            <input type="hidden" name="ordenId" value="@primera.OrdenId" />
            <button type="submit" class="btn btn-success">
                <i class="fa-solid fa-circle-check me-1"></i> Marcar como Atendido
            </button>
        </form>
    }
</div>