@model Control_flota.Models.Operaciones.DespachoViewModel
@{
    ViewData["Title"] = "Despacho";
}

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .page-subtitle { color: #64748b; margin: 0; font-size: 0.9rem; }
    .header-actions { display: flex; gap: 10px; }

    .btn-primary-custom {
        background-color: #2563eb; color: white; border: none;
        padding: 9px 18px; border-radius: 8px; font-weight: 600;
        font-size: 0.875rem; text-decoration: none;
        display: inline-flex; align-items: center; gap: 6px;
        cursor: pointer; transition: background 0.2s;
    }
    .btn-primary-custom:hover { background-color: #1d4ed8; color: white; }

    .btn-secondary-custom {
        background-color: #f1f5f9; color: #475569; border: none;
        padding: 9px 18px; border-radius: 8px; font-weight: 600;
        font-size: 0.875rem; text-decoration: none;
        display: inline-flex; align-items: center; gap: 6px;
        cursor: pointer; transition: background 0.2s;
    }
    .btn-secondary-custom:hover { background-color: #e2e8f0; color: #1e293b; }

    .btn-success-custom {
        background-color: #16a34a; color: white; border: none;
        padding: 9px 18px; border-radius: 8px; font-weight: 600;
        font-size: 0.875rem; text-decoration: none;
        display: inline-flex; align-items: center; gap: 6px;
        cursor: pointer; transition: background 0.2s;
    }
    .btn-success-custom:hover { background-color: #15803d; color: white; }

    .stats-row { display: flex; gap: 16px; margin-bottom: 24px; }

    .stat-card {
        background: white; border: 1px solid #e2e8f0; border-radius: 12px;
        padding: 16px 24px; flex: 1; display: flex; align-items: center; gap: 14px;
    }

    .stat-icon {
        width: 42px; height: 42px; border-radius: 10px;
        display: flex; align-items: center; justify-content: center; font-size: 1.1rem;
    }
    .stat-icon.blue   { background: #eff6ff; color: #2563eb; }
    .stat-icon.orange { background: #fff7ed; color: #ea580c; }
    .stat-icon.green  { background: #f0fdf4; color: #16a34a; }

    .stat-info .number { font-size: 1.4rem; font-weight: 700; color: #0f172a; line-height: 1; }
    .stat-info .label  { font-size: 0.78rem; color: #94a3b8; margin-top: 2px; }

    .section-title {
        font-size: 1rem; font-weight: 700; color: #0f172a;
        padding: 16px 20px; border-bottom: 1px solid #e2e8f0;
        display: flex; align-items: center; gap: 8px;
    }

    .table-card {
        background: white; border: 1px solid #e2e8f0;
        border-radius: 12px; overflow: hidden; margin-bottom: 20px;
    }
    .table-card table { margin: 0; }

    .table-card thead th {
        background: #f8fafc; color: #475569; font-size: 0.75rem;
        font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;
        padding: 13px 20px; border-bottom: 1px solid #e2e8f0; border-top: none;
    }

    .table-card tbody td {
        padding: 13px 20px; color: #1e293b; font-size: 0.875rem;
        vertical-align: middle; border-bottom: 1px solid #f1f5f9;
    }
    .table-card tbody tr:last-child td { border-bottom: none; }
    .table-card tbody tr:hover { background: #f8fafc; }

    .codigo { font-weight: 700; font-family: monospace; font-size: 0.85rem; color: #0f172a; }
    .sub-text { font-size: 0.8rem; color: #94a3b8; margin-top: 2px; }

    .badge-estado {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 4px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: 600;
    }
    .badge-emitida   { background: #f0fdf4; color: #16a34a; }
    .badge-pendiente { background: #fff7ed; color: #ea580c; }
    .badge-otro      { background: #f1f5f9; color: #64748b; }

    .action-btn {
        border: none; padding: 5px 12px; border-radius: 6px;
        font-size: 0.78rem; font-weight: 600; cursor: pointer;
        text-decoration: none; display: inline-flex; align-items: center;
        gap: 4px; transition: all 0.15s;
    }
    .action-btn.assign { background: #eff6ff; color: #2563eb; }
    .action-btn.assign:hover { background: #dbeafe; }
    .action-btn.view   { background: #f1f5f9; color: #475569; }
    .action-btn.view:hover { background: #e2e8f0; }
    .action-btn.delete { background: #fef2f2; color: #dc2626; }
    .action-btn.delete:hover { background: #fee2e2; }

    .filter-bar {
        background: white; border: 1px solid #e2e8f0; border-radius: 12px;
        padding: 14px 20px; margin-bottom: 20px;
        display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    }

    .filter-bar input {
        border: 1px solid #e2e8f0; border-radius: 8px;
        padding: 8px 14px; font-size: 0.875rem; flex: 1; outline: none;
    }
    .filter-bar input:focus { border-color: #2563eb; }

    .weight-btn {
        border: 1px solid #e2e8f0; background: white; border-radius: 6px;
        padding: 6px 14px; font-size: 0.8rem; font-weight: 600;
        color: #475569; cursor: pointer; transition: all 0.15s;
    }
    .weight-btn:hover { background: #eff6ff; border-color: #2563eb; color: #2563eb; }
</style>

@{
    var totalOrdenes   = Model.Ordenes.Count();
    var pendientes     = Model.SolicitudesPendientes.Count();
    var emitidas       = Model.Ordenes.Count(o => o.Estado == "Emitida");
}

<!-- HEADER -->
<div class="page-header">
    <div>
        <h2 style="font-size:1.75rem; font-weight:700; color:#0f172a; margin:0;">Centro de Despacho</h2>
        <p class="page-subtitle">Gestión de órdenes y solicitudes</p>
    </div>
    <div class="header-actions">
        <a href="@Url.Action("Index", "Solicitudes")" class="btn-secondary-custom">
            <i class="fa-solid fa-list"></i> Ver solicitudes
        </a>
        <button type="button" class="btn-success-custom"
                data-bs-toggle="modal" data-bs-target="#nuevaSolicitudModal">
            <i class="fa-solid fa-plus"></i> Nueva Solicitud
        </button>
    </div>
</div>

<!-- STATS -->
<div class="stats-row">
    <div class="stat-card">
        <div class="stat-icon blue"><i class="fa-regular fa-file-lines"></i></div>
        <div class="stat-info">
            <div class="number">@totalOrdenes</div>
            <div class="label">Total órdenes</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon orange"><i class="fa-solid fa-clock"></i></div>
        <div class="stat-info">
            <div class="number">@pendientes</div>
            <div class="label">Pendientes de asignación</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon green"><i class="fa-solid fa-circle-check"></i></div>
        <div class="stat-info">
            <div class="number">@emitidas</div>
            <div class="label">Órdenes emitidas</div>
        </div>
    </div>
</div>

<!-- FILTROS -->
<div class="filter-bar">
    <form method="get" style="display:flex; align-items:center; gap:10px; flex:1; flex-wrap:wrap;">
        <i class="fa-solid fa-magnifying-glass" style="color:#94a3b8;"></i>
        <input type="text" name="buscar" placeholder="Buscar por cliente, origen o destino..." />
        <div style="display:flex; gap:6px;">
            <button type="submit" name="peso" value=""      class="weight-btn">Todos</button>
            <button type="submit" name="peso" value="2000"  class="weight-btn">2T</button>
            <button type="submit" name="peso" value="5000"  class="weight-btn">5T</button>
            <button type="submit" name="peso" value="10000" class="weight-btn">10T</button>
        </div>
    </form>
</div>

<!-- SOLICITUDES PENDIENTES -->
@if (Model.SolicitudesPendientes.Any())
{
    <div class="table-card">
        <div class="section-title">
            <i class="fa-solid fa-clock" style="color:#ea580c;"></i>
            Solicitudes pendientes de asignación
            <span style="background:#fff7ed; color:#ea580c; padding:2px 10px; border-radius:20px; font-size:0.75rem;">
                @pendientes
            </span>
        </div>
        <table class="table">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Cliente</th>
                    <th>Ruta</th>
                    <th>Peso / Carga</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.SolicitudesPendientes)
                {
                    <tr>
                        <td><span class="codigo">@s.Codigo</span></td>
                        <td>@s.Cliente?.Nombre</td>
                        <td>
                            <div style="font-weight:500;">@s.Origen</div>
                            <div class="sub-text"><i class="fa-solid fa-arrow-down" style="font-size:0.65rem;"></i> @s.Destino</div>
                        </td>
                        <td>
                            <div>@s.PesoKg kg</div>
                            <div class="sub-text">@s.TipoCarga</div>
                        </td>
                        <td>
                            <span class="badge-estado badge-pendiente">
                                <i class="fa-solid fa-circle" style="font-size:0.5rem;"></i> @s.EstadoSolicitud
                            </span>
                        </td>
                        <td>
                            <div style="display:flex; gap:6px;">
                                <a href="@Url.Action("AsignarFlota", "Solicitudes", new { id = s.Id })" class="action-btn assign">
                                    <i class="fa-solid fa-truck"></i> Asignar
                                </a>
                                <a href="@Url.Action("Details", "Solicitudes", new { id = s.Id })" class="action-btn view">
                                    <i class="fa-regular fa-eye"></i> Ver
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- ÓRDENES -->
<div class="table-card">
    <div class="section-title">
        <i class="fa-regular fa-file-lines" style="color:#2563eb;"></i>
        Órdenes de viaje
    </div>
    @if (!Model.Ordenes.Any())
    {
        <div style="text-align:center; padding:50px; color:#94a3b8;">
            <i class="fa-regular fa-file-lines" style="font-size:2rem; display:block; margin-bottom:10px;"></i>
            <p>No hay órdenes generadas aún.</p>
        </div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Fecha</th>
                    <th>Cliente</th>
                    <th>Ruta</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var orden in Model.Ordenes)
                {
                    string badgeClass = orden.Estado == "Emitida" ? "badge-emitida" : "badge-otro";
                    <tr>
                        <td><span class="codigo">@orden.Codigo</span></td>
                        <td>@orden.FechaEmision.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@orden.Cliente?.Nombre</td>
                        <td>
                            <div style="font-weight:500;">@orden.Origen</div>
                            <div class="sub-text"><i class="fa-solid fa-arrow-down" style="font-size:0.65rem;"></i> @orden.Destino</div>
                        </td>
                        <td>
                            <span class="badge-estado @badgeClass">
                                <i class="fa-solid fa-circle" style="font-size:0.5rem;"></i> @orden.Estado
                            </span>
                        </td>
                        <td>
                            <div style="display:flex; gap:6px;">
                                <a href="@Url.Action("Details", "Ordenes", new { id = orden.Id })" class="action-btn view">
                                    <i class="fa-regular fa-eye"></i> Ver
                                </a>
                                <form method="post" asp-action="Eliminar" asp-route-id="@orden.Id"
                                      style="display:inline;" onsubmit="return confirm('¿Eliminar esta orden?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="action-btn delete">
                                        <i class="fa-regular fa-trash-can"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<!-- MODAL NUEVA SOLICITUD -->
<div class="modal fade" id="nuevaSolicitudModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="border-radius:16px; border:none;">
            <div class="modal-header" style="border-bottom:1px solid #e2e8f0; padding:20px 24px;">
                <h5 class="modal-title" style="font-weight:700; color:#0f172a;">
                    <i class="fa-solid fa-plus me-2" style="color:#16a34a;"></i>Nueva Solicitud de Servicio
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-controller="Solicitudes" asp-action="RegistrarServicio">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Ordenes")" />
                <div class="modal-body" style="padding:24px;">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Cliente</label>
                        <select name="ClienteId" class="form-control" required>
                            <option value="">Seleccione un cliente</option>
                            @foreach (var cliente in ViewBag.Clientes)
                            {
                                <option value="@cliente.Id">@cliente.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Origen</label>
                            <input type="text" name="Origen" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Destino</label>
                            <input type="text" name="Destino" class="form-control" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Peso (Kg)</label>
                            <input type="number" step="0.01" name="PesoKg" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Tipo de Carga</label>
                            <select name="TipoCarga" class="form-control" required>
                                <option value="">Seleccione tipo de carga</option>
                                @foreach (var tipo in ViewBag.TipoCargaOptions)
                                {
                                    <option value="@tipo">@tipo</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="border-top:1px solid #e2e8f0; padding:16px 24px;">
                    <button type="button" class="btn-secondary-custom" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn-success-custom">
                        <i class="fa-solid fa-check"></i> Guardar Solicitud
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>