@model IEnumerable<Control_flota.Models.Operaciones.Orden>
@{
    ViewData["Title"] = "Mis Viajes";
}

<style>
    .page-subtitle { color: #64748b; margin: 4px 0 0; font-size: 0.9rem; }

    .stats-row { display: flex; gap: 16px; margin-bottom: 24px; }

    .stat-card {
        background: white; border: 1px solid #e2e8f0; border-radius: 12px;
        padding: 16px 24px; flex: 1; display: flex; align-items: center; gap: 14px;
    }

    .stat-icon {
        width: 42px; height: 42px; border-radius: 10px;
        display: flex; align-items: center; justify-content: center; font-size: 1.1rem;
    }
    .stat-icon.blue   { background: #eff6ff; color: #2563eb; }
    .stat-icon.orange { background: #fff7ed; color: #ea580c; }
    .stat-icon.green  { background: #f0fdf4; color: #16a34a; }

    .stat-info .number { font-size: 1.4rem; font-weight: 700; color: #0f172a; line-height: 1; }
    .stat-info .label  { font-size: 0.78rem; color: #94a3b8; margin-top: 2px; }

    .table-card {
        background: white; border: 1px solid #e2e8f0;
        border-radius: 12px; overflow: hidden;
    }
    .table-card table { margin: 0; }

    .table-card thead th {
        background: #f8fafc; color: #475569; font-size: 0.75rem;
        font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;
        padding: 13px 20px; border-bottom: 1px solid #e2e8f0; border-top: none;
    }

    .table-card tbody td {
        padding: 14px 20px; color: #1e293b; font-size: 0.875rem;
        vertical-align: middle; border-bottom: 1px solid #f1f5f9;
    }
    .table-card tbody tr:last-child td { border-bottom: none; }
    .table-card tbody tr:hover { background: #f8fafc; }

    .codigo { font-weight: 700; font-family: monospace; font-size: 0.85rem; }
    .sub-text { font-size: 0.8rem; color: #94a3b8; margin-top: 2px; }

    .badge-estado {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 4px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 600;
    }
    .badge-emitida    { background: #eff6ff; color: #2563eb; }
    .badge-transito   { background: #fff7ed; color: #ea580c; }
    .badge-completado { background: #f0fdf4; color: #16a34a; }

    .action-btn {
        border: none; padding: 8px 18px; border-radius: 8px;
        font-size: 0.85rem; font-weight: 600; cursor: pointer;
        display: inline-flex; align-items: center; gap: 6px; transition: all 0.15s;
    }
    .btn-iniciar   { background: #2563eb; color: white; }
    .btn-iniciar:hover { background: #1d4ed8; }
    .btn-finalizar { background: #16a34a; color: white; }
    .btn-finalizar:hover { background: #15803d; }
    .btn-disabled  { background: #f1f5f9; color: #94a3b8; cursor: not-allowed; }
</style>

@{
    var emitidas   = Model.Count(o => o.Estado == "Emitida");
    var enTransito = Model.Count(o => o.Estado == "En Tránsito");
    var completadas = Model.Count(o => o.Estado == "Completado");
    var totalGastos = Model.Sum(o => o.Gastos?.Sum(g => g.Monto) ?? 0);
}

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div style="margin-bottom:24px;">
    <h2 style="font-size:1.75rem; font-weight:700; color:#0f172a; margin:0;">Mis Viajes</h2>
    <p class="page-subtitle">Panel del conductor — órdenes asignadas</p>
</div>

<div class="stats-row">
    <div class="stat-card">
        <div class="stat-icon blue"><i class="fa-regular fa-file-lines"></i></div>
        <div class="stat-info">
            <div class="number">@emitidas</div>
            <div class="label">Pendientes de inicio</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon orange"><i class="fa-solid fa-road"></i></div>
        <div class="stat-info">
            <div class="number">@enTransito</div>
            <div class="label">En tránsito</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon green"><i class="fa-solid fa-circle-check"></i></div>
        <div class="stat-info">
            <div class="number">@completadas</div>
            <div class="label">Completados</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:#f3e8ff; color:#9333ea;">
            <i class="fa-solid fa-file-invoice-dollar"></i>
        </div>
        <div class="stat-info">
            <div class="number">S/ @totalGastos.ToString("0.00")</div>
            <div class="label">Total Gastos</div>
        </div>
    </div>
</div>

<div class="table-card">
    @if (!Model.Any())
    {
        <div style="text-align:center; padding:60px; color:#94a3b8;">
            <i class="fa-solid fa-truck" style="font-size:2.5rem; display:block; margin-bottom:12px;"></i>
            <p>No tienes órdenes asignadas aún.</p>
        </div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Orden</th>
                    <th>Cliente</th>
                    <th>Ruta</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var orden in Model)
            {
                string badgeClass = orden.Estado switch {
                    "Emitida"    => "badge-emitida",
                    "En Tránsito" => "badge-transito",
                    "Completado"  => "badge-completado",
                    _ => "badge-emitida"
                };

                <tr>
                    <td><span class="codigo">@orden.Codigo</span></td>
                    <td>@orden.Cliente?.Nombre</td>
                    <td>
                        <div style="font-weight:500;">@orden.Origen</div>
                        <div class="sub-text">
                            <i class="fa-solid fa-arrow-down" style="font-size:0.65rem;"></i> @orden.Destino
                        </div>
                    </td>
                    <td>@orden.FechaEmision.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <span class="badge-estado @badgeClass">
                            <i class="fa-solid fa-circle" style="font-size:0.5rem;"></i>
                            @orden.Estado
                        </span>
                    </td>
                    <td>
                        <div style="display:flex; flex-direction:column; gap:6px;">
                            @if (orden.Estado == "Emitida")
                            {
                                <button type="button" class="action-btn btn-iniciar" style="width:100%; justify-content:center;" data-bs-toggle="modal" data-bs-target="#iniciarModal" data-ordenid="@orden.Id" data-codigo="@orden.Codigo">
                                    <i class="fa-solid fa-play"></i> Iniciar Ruta
                                </button>
                            }
                            else if (orden.Estado == "En Tránsito")
                            {
                                <div style="display:flex; flex-direction:column; gap:6px;">
                                    <button type="button" class="action-btn btn-finalizar" style="width:100%; justify-content:center;"
                                            data-bs-toggle="modal" data-bs-target="#finalizarModal"
                                            data-ordenid="@orden.Id" data-codigo="@orden.Codigo">
                                        <i class="fa-solid fa-flag-checkered"></i> Finalizar Ruta
                                    </button>
                                    <button type="button"class="action-btn"style="background:#fee2e2; color:#dc2626; width:100%; justify-content:center;"
                                             data-bs-toggle="modal"data-bs-target="#incidenciaModal"
                                             data-ordenid="@orden.Id">
                                        <i class="fa-solid fa-triangle-exclamation"></i> Reportar Incidencia
                                    </button>
                                    <button type="button" class="action-btn"
        style="background:#ede9fe; color:#7c3aed; width:100%; justify-content:center;"
        data-bs-toggle="modal"
        data-bs-target="#evidenciaModal"
        data-ordenid="@orden.Id">
    <i class="fa-solid fa-camera"></i> Tomar Evidencias
</button>
                                    <form method="post" asp-action="ReportarUbicacion" asp-route-id="@orden.Id"
                                        style="display:flex; gap:4px;">
                                        @Html.AntiForgeryToken()
                                        <input type="text" name="ciudad" placeholder="Ciudad actual..."
                                            style="border:1px solid #e2e8f0; border-radius:6px; padding:5px 10px; font-size:0.8rem; width:130px;" required />
                                        <button type="submit" class="action-btn" style="background:#eff6ff; color:#2563eb;">
                                            <i class="fa-solid fa-location-dot"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <span class="action-btn btn-disabled" style="width:100%; justify-content:center;">
                                    <i class="fa-solid fa-check"></i> Completado
                                </span>
                            }

                            <a href="@Url.Action("DescargarConstancia", new { id = orden.Id })"
                               class="action-btn" style="background:#f0fdf4; color:#16a34a; text-decoration:none; justify-content:center;">
                                <i class="fa-solid fa-file-arrow-down"></i> Constancia PDF
                            </a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

<div class="modal fade" id="iniciarModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="IniciarRutaConDatos" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ordenId" id="modalOrdenId" />
                <div class="modal-header">
                    <h5 class="modal-title">Datos iniciales de la unidad</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Combustible disponible (galones)</label>
                        <input type="text" inputmode="decimal" name="combustibleInicial" id="combustibleInicial" class="form-control" placeholder="Ej. 45.5" required />
                        <div class="form-text text-danger" id="combustibleError" style="display:none;">Ingrese un número válido >= 0</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Kilometraje actual</label>
                        <input type="text" inputmode="numeric" name="kilometrajeInicial" id="kilometrajeInicial" class="form-control" placeholder="Ej. 120345" required />
                        <div class="form-text text-danger" id="kmError" style="display:none;">Ingrese un número entero válido >= 0</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Observación (opcional)</label>
                        <textarea name="observacion" id="observacion" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Foto (opcional, máx. 5MB)</label>
                        <input type="file" name="fotoInicio" id="fotoInicio" class="form-control" accept="image/*" capture="environment" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" id="modalSubmit" class="btn btn-primary">Iniciar Ruta</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="finalizarModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="FinalizarRuta" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ordenId" id="finalizarOrdenId" />
                <div class="modal-header">
                    <h5 class="modal-title">Finalizar Ruta</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nombre completo del recepcionista</label>
                        <input type="text" name="recepcionistaNombre" id="recepcionistaNombre" class="form-control"
                               pattern="[A-Za-zÀ-ÿÑñ ]+"
                               oninput="this.value = this.value.replace(/[^A-Za-zÀ-ÿÑñ ]/g, '');"
                               required />
                        <div class="form-text text-danger" id="recepcionistaNombreError" style="display:none;">Ingrese el nombre completo del recepcionista sin números ni símbolos.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">DNI del recepcionista</label>
                        <input type="text" name="recepcionistaDni" id="recepcionistaDni" class="form-control" pattern="\d{8}" required placeholder="Ej. 12345678" />
                        <div class="form-text text-danger" id="recepcionistaDniError" style="display:none;">Ingrese un DNI válido de 8 dígitos.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Kilometraje Final de la Unidad</label>
                        <input type="number" name="kilometrajeFinal" id="kilometrajeFinal" class="form-control" required min="0" placeholder="Ej. 120500" />
                        <div class="form-text text-danger" id="kmFinalError" style="display:none;">Ingrese un kilometraje válido (mayor o igual a cero).</div>
                        <div class="form-text text-muted" style="font-size:0.8rem;">Recuerda: El kilometraje final no puede ser menor al inicial con el que arrancaste.</div>
                    </div>

                    <div class="alert alert-info" role="alert" style="font-size:0.9rem; margin-bottom:0;">
                        Se validará el nombre y DNI del recepcionista con los datos registrados en la solicitud de servicio.
                    </div>
                        <div class="mb-3" style="margin-top:12px;">
                            <div class="form-text" style="font-size:0.9rem; color:#0f172a; margin-bottom:6px;">
                                Debe tomar una foto de la constancia de viaje con la cámara.
                            </div>
                            <button type="button" class="action-btn" style="background:#e2e8f0; color:#2563eb; width:100%; justify-content:center;" id="btnTomarFoto">
                                <i class="fa-solid fa-camera"></i> Tomar foto
                            </button>
                            <div class="form-text" style="font-size:0.8rem; color:#94a3b8; margin-top:6px;" id="fotoStatus">No se ha tomado foto aún.</div>
                            <input type="hidden" name="fotoFinal" id="fotoFinal" />
                            <div class="form-text text-danger" id="fotoFinalError" style="display:none; font-size:0.8rem; margin-top:4px;">Debe tomar una foto antes de finalizar la ruta.</div>
                        </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" id="finalizarSubmit" class="btn btn-primary">Finalizar Ruta</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="cameraModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Tomar foto de la constancia</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <video id="cameraVideo" autoplay playsinline style="width:100%; max-height:480px; background:#000;"></video>
                <canvas id="cameraCanvas" style="display:none;"></canvas>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="btnStopCamera">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnCapture">Aceptar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="previewFotoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Previsualizar foto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <img id="previewImage" src="" style="width:100%; height:auto;" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="btnRetake">Volver a tomar</button>
                <button type="button" class="btn btn-success" id="btnUsePhoto">Subir evidencia</button>
            </div>
        </div>
    </div>
</div>

<button id="openCameraModalBtn" type="button" data-bs-toggle="modal" data-bs-target="#cameraModal" style="display:none;"></button>
<button id="openPreviewModalBtn" type="button" data-bs-toggle="modal" data-bs-target="#previewFotoModal" style="display:none;"></button>
<button id="openFinalizarModalBtn" type="button" data-bs-toggle="modal" data-bs-target="#finalizarModal" style="display:none;"></button>

<div class="modal fade" id="incidenciaModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form asp-action="ReportarIncidencia" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" id="incidenciaOrdenId" name="OrdenId" />
                <input type="hidden" id="latitud" name="Latitud" />
                <input type="hidden" id="longitud" name="Longitud" />

                <div class="modal-header">
                    <h5 class="modal-title">
                        Reportar Incidencia
                    </h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">
                            Tipo de Incidencia
                        </label>

                        <select id="tipoIncidencia"
                                name="TipoIncidencia"
                                class="form-control"
                                required>

                            <option value="">
                                Seleccione...
                            </option>

                            <option value="Tráfico">
                                Tráfico
                            </option>

                            <option value="Falla Mecánica">
                                Falla Mecánica
                            </option>

                            <option value="Accidente">
                                Accidente
                            </option>

                            <option value="Otro">
                                Otro
                            </option>

                        </select>
                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Descripción
                        </label>

                        <textarea id="descripcionIncidencia"
                                  name="Descripcion"
                                  class="form-control"
                                  rows="4"
                                  disabled
                                  required></textarea>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-danger">
                        Enviar Alerta
                    </button>

                </div>

            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="evidenciaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="SubirEvidencia" method="post" enctype="multipart/form-data" id="formEvidencia">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ordenId" id="evidenciaOrdenId" />
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fa-solid fa-camera me-2"></i> Tomar Evidencias
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p style="font-size:0.85rem; color:#64748b;">
                        Puedes subir máximo <strong>3 fotos</strong> de evidencia durante la ruta.
                    </p>
                    <div class="mb-3">
                        <label class="form-label">Seleccionar foto</label>
                        <input type="file" name="foto" id="evidenciaFoto"
                               class="form-control" accept="image/*" required />
                    </div>
                    <div id="evidenciaPreview" style="display:none; margin-top:10px; text-align:center;">
                        <img id="evidenciaImgPreview" src=""
                             style="max-width:100%; max-height:200px; border-radius:8px; border:1px solid #e2e8f0;" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="btnSubirEvidencia">
                        <i class="fa-solid fa-upload me-1"></i> Subir Foto
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>





<script>
    var skipFinalizarReset = false;
    
    // Variables globales para validación
    var fotoFinalInput = document.getElementById('fotoFinal');
    var fotoFinalError = document.getElementById('fotoFinalError');
    var recepcionistaNombre = document.getElementById('recepcionistaNombre');
    var recepcionistaDni = document.getElementById('recepcionistaDni');
    var recepcionistaNombreError = document.getElementById('recepcionistaNombreError');
    var recepcionistaDniError = document.getElementById('recepcionistaDniError');
    var finalizarSubmit = document.getElementById('finalizarSubmit');
    
    // VARIABLES PARA HU-014
    var kilometrajeFinalInput = document.getElementById('kilometrajeFinal');
    var kmFinalError = document.getElementById('kmFinalError');

    // Función global para validar modal de finalización
    function validarFinalizarModal(){
        if(!recepcionistaNombre || !recepcionistaDni || !finalizarSubmit) return;
        
        var nombreVal = (recepcionistaNombre.value || '').trim();
        var dniVal = (recepcionistaDni.value || '').trim();
        var fotoVal = (fotoFinalInput && fotoFinalInput.value) ? (fotoFinalInput.value || '').trim() : '';
        var kmFinalVal = (kilometrajeFinalInput && kilometrajeFinalInput.value) ? kilometrajeFinalInput.value.trim() : '';
        
        var nombreValido = /^[A-Za-zÀ-ÿÑñ ]{3,}$/.test(nombreVal);
        var dniValido = /^\d{8}$/.test(dniVal);
        var fotoValida = fotoVal.length > 0;
        var kmFinalValido = kmFinalVal !== '' && /^\d+$/.test(kmFinalVal) && parseInt(kmFinalVal, 10) >= 0;

        if(recepcionistaNombreError){
            if(!nombreValido && nombreVal !== ''){
                recepcionistaNombreError.style.display = 'block';
            } else {
                recepcionistaNombreError.style.display = 'none';
            }
        }
        if(recepcionistaDniError){
            if(!dniValido && dniVal !== ''){
                recepcionistaDniError.style.display = 'block';
            } else {
                recepcionistaDniError.style.display = 'none';
            }
        }
        if(fotoFinalError){
            if(!fotoValida){
                fotoFinalError.style.display = 'block';
            } else {
                fotoFinalError.style.display = 'none';
            }
        }
        if(kmFinalError){
            if(!kmFinalValido && kmFinalVal !== ''){
                kmFinalError.style.display = 'block';
            } else {
                kmFinalError.style.display = 'none';
            }
        }

        finalizarSubmit.disabled = !(nombreValido && dniValido && fotoValida && kmFinalValido);
    }
    
    (function(){
        var iniciarModal = document.getElementById('iniciarModal');
        if(!iniciarModal) return;

        var modalSubmit = document.getElementById('modalSubmit');
        var combustibleInput = document.getElementById('combustibleInicial');
        var kmInput = document.getElementById('kilometrajeInicial');
        var combustibleError = document.getElementById('combustibleError');
        var kmError = document.getElementById('kmError');
        var finalizarModal = document.getElementById('finalizarModal');

        function isDecimal(value){
            return /^\d+(?:[\.,]\d+)?$/.test(value.trim());
        }
        function isInteger(value){
            return /^\d+$/.test(value.trim());
        }

        function validarModal(){
            var cVal = (combustibleInput.value || '').trim();
            var kmVal = (kmInput.value || '').trim();

            var combustibleValido = isDecimal(cVal) && parseFloat(cVal.replace(',', '.')) >= 0;
            var kmValido = isInteger(kmVal) && parseInt(kmVal, 10) >= 0;

            if(!combustibleValido){
                combustibleError.style.display = 'block';
                combustibleError.textContent = 'Ingrese un número válido >= 0 (solo dígitos y opcionalmente "." o ",")';
            } else {
                combustibleError.style.display = 'none';
            }

            if(!kmValido){
                kmError.style.display = 'block';
                kmError.textContent = 'Ingrese un número entero válido >= 0 (solo dígitos)';
            } else {
                kmError.style.display = 'none';
            }

            modalSubmit.disabled = !(combustibleValido && kmValido);
        }

        iniciarModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var ordenId = button.getAttribute('data-ordenid');
            document.getElementById('modalOrdenId').value = ordenId;
            combustibleInput.value = '';
            kmInput.value = '';
            document.getElementById('observacion').value = '';
            document.getElementById('fotoInicio').value = '';
            validarModal();
        });

        if(finalizarModal){
            finalizarModal.addEventListener('show.bs.modal', function (event) {
                if (skipFinalizarReset) {
                    skipFinalizarReset = false;
                    validarFinalizarModal();
                    return;
                }
                var button = event.relatedTarget;
                if (button) {
                    var ordenId = button.getAttribute('data-ordenid');
                    document.getElementById('finalizarOrdenId').value = ordenId;
                }
                if(recepcionistaNombre) recepcionistaNombre.value = '';
                if(recepcionistaDni) recepcionistaDni.value = '';
                if(kilometrajeFinalInput) kilometrajeFinalInput.value = '';
                validarFinalizarModal();
            });
            if(recepcionistaNombre) recepcionistaNombre.addEventListener('input', validarFinalizarModal);
            if(recepcionistaDni) recepcionistaDni.addEventListener('input', validarFinalizarModal);
            if(kilometrajeFinalInput) kilometrajeFinalInput.addEventListener('input', validarFinalizarModal);
        }

        combustibleInput.addEventListener('input', validarModal);
        kmInput.addEventListener('input', validarModal);

        validarModal();
        validarFinalizarModal();
    })();

    (function(){
        // Esperar a que el DOM esté completamente cargado
        if(document.readyState === 'loading'){
            document.addEventListener('DOMContentLoaded', initCamera);
        } else {
            initCamera();
        }

        function initCamera(){
            var btnTomarFoto = document.getElementById('btnTomarFoto');
            var cameraModalEl = document.getElementById('cameraModal');
            var previewModalEl = document.getElementById('previewFotoModal');
            var openCameraModalBtn = document.getElementById('openCameraModalBtn');
            var openPreviewModalBtn = document.getElementById('openPreviewModalBtn');
            var openFinalizarModalBtn = document.getElementById('openFinalizarModalBtn');
            
            if(!btnTomarFoto || !cameraModalEl || !previewModalEl || !openCameraModalBtn || !openPreviewModalBtn || !openFinalizarModalBtn){
                console.error('Camera: Falta un elemento requerido');
                return;
            }

            var video = document.getElementById('cameraVideo');
            var canvas = document.getElementById('cameraCanvas');
            var previewImage = document.getElementById('previewImage');
            var btnCapture = document.getElementById('btnCapture');
            var btnStopCamera = document.getElementById('btnStopCamera');
            var btnRetake = document.getElementById('btnRetake');
            var btnUsePhoto = document.getElementById('btnUsePhoto');
            var fotoStatus = document.getElementById('fotoStatus');
            var finalizarModal = document.getElementById('finalizarModal');
            var stream = null;
            var lastDataUrl = '';
            var preserveFinalizar = false;
            var openingPreview = false;
            var reopenFinalizarOnPreviewClose = false;

            function isModalShown(modalEl){
                return modalEl && modalEl.classList.contains('show');
            }

            function closeModal(modalEl){
                if(!modalEl) return;
                var closeBtn = modalEl.querySelector('.btn-close, [data-bs-dismiss="modal"]');
                if(closeBtn) closeBtn.click();
            }

            function stopStream(){
                if(stream){
                    stream.getTracks().forEach(function(t){ t.stop(); });
                    stream = null;
                }
                if(video){
                    try{ video.pause(); video.srcObject = null; }catch(e){}
                }
            }

            function openModalByButton(button){
                if(!button) return;
                button.click();
            }

            function startCamera(){
                if(!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){
                    alert('El navegador no soporta acceso a la cámara.');
                    return;
                }
                preserveFinalizar = isModalShown(finalizarModal);
                if (preserveFinalizar) {
                    closeModal(finalizarModal);
                }
                navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } })
                    .then(function(s){
                        stream = s;
                        video.srcObject = stream;
                        video.play();
                        openModalByButton(openCameraModalBtn);
                    })
                    .catch(function(err){
                        alert('No se pudo acceder a la cámara: ' + (err.message || err));
                    });
            }

            btnTomarFoto.addEventListener('click', function(){ 
                startCamera(); 
            });

            if(btnStopCamera){
                btnStopCamera.addEventListener('click', function(){
                    stopStream();
                    closeModal(cameraModalEl);
                    if(preserveFinalizar) openModalByButton(openFinalizarModalBtn);
                });
            }

            if(btnCapture){
                btnCapture.addEventListener('click', function(){
                    if(!video) return;
                    var w = video.videoWidth || 1280;
                    var h = video.videoHeight || 720;
                    var maxW = 1280;
                    var ratio = w / (h || 1);
                    var targetW = w;
                    var targetH = h;
                    if(w > maxW){ targetW = maxW; targetH = Math.round(targetW / ratio); }
                    canvas.width = targetW; canvas.height = targetH;
                    var ctx = canvas.getContext('2d');
                    ctx.drawImage(video, 0, 0, targetW, targetH);
                    var dataUrl = canvas.toDataURL('image/jpeg', 0.8);
                    lastDataUrl = dataUrl;
                    if(previewImage) previewImage.src = dataUrl;
                    stopStream();
                    openingPreview = true;
                    closeModal(cameraModalEl);
                    openModalByButton(openPreviewModalBtn);
                });
            }

            if(btnRetake){
                btnRetake.addEventListener('click', function(){
                    closeModal(previewModalEl);
                    startCamera();
                });
            }

            if(btnUsePhoto){
                btnUsePhoto.addEventListener('click', function(){
                    if(!lastDataUrl) return;
                    if(fotoFinalInput) fotoFinalInput.value = lastDataUrl;
                    if(fotoStatus) fotoStatus.textContent = 'Foto tomada correctamente.';
                    reopenFinalizarOnPreviewClose = preserveFinalizar;
                    skipFinalizarReset = true;
                    // Validar para habilitar botón de finalizar
                    validarFinalizarModal();
                    closeModal(previewModalEl);
                });
            }

            cameraModalEl.addEventListener('hidden.bs.modal', function(){
                if(openingPreview){
                    openingPreview = false;
                    return;
                }
                if(preserveFinalizar){
                    openModalByButton(document.getElementById('finalizarModal') ? document.getElementById('finalizarModal') : null);
                }
            });

            previewModalEl.addEventListener('hidden.bs.modal', function(){
                if(reopenFinalizarOnPreviewClose){
                    reopenFinalizarOnPreviewClose = false;
                    openModalByButton(openFinalizarModalBtn);
                }
            });
        }
    })();

    var incidenciaModal = document.getElementById('incidenciaModal');

if (incidenciaModal) {

    incidenciaModal.addEventListener('show.bs.modal', function (event) {

        var button = event.relatedTarget;

        var ordenId = button.getAttribute('data-ordenid');

        document.getElementById('incidenciaOrdenId').value = ordenId;

        document.getElementById('tipoIncidencia').value = '';
        document.getElementById('descripcionIncidencia').value = '';
        document.getElementById('descripcionIncidencia').disabled = true;

        if (navigator.geolocation) {

            navigator.geolocation.getCurrentPosition(function(position) {

                document.getElementById('latitud').value =
                    position.coords.latitude;

                document.getElementById('longitud').value =
                    position.coords.longitude;

            });

        }

    });

    document.getElementById('tipoIncidencia')
        .addEventListener('change', function() {

            document.getElementById('descripcionIncidencia')
                .disabled = this.value === '';

        });

}

// Modal de evidencias
var evidenciaModal = document.getElementById('evidenciaModal');
if (evidenciaModal) {
    evidenciaModal.addEventListener('show.bs.modal', function(event) {
        var button = event.relatedTarget;
        var ordenId = button.getAttribute('data-ordenid');
        document.getElementById('evidenciaOrdenId').value = ordenId;
        document.getElementById('evidenciaFoto').value = '';
        document.getElementById('evidenciaPreview').style.display = 'none';
        document.getElementById('evidenciaImgPreview').src = '';
    });

    document.getElementById('evidenciaFoto').addEventListener('change', function() {
        var file = this.files[0];
        if (file) {
            var reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('evidenciaImgPreview').src = e.target.result;
                document.getElementById('evidenciaPreview').style.display = 'block';
            };
            reader.readAsDataURL(file);
        } else {
            document.getElementById('evidenciaPreview').style.display = 'none';
        }
    });
}
</script>