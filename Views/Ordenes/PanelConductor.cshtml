@model IEnumerable<Control_flota.Models.Operaciones.Orden>
@{
    ViewData["Title"] = "Mis Viajes";
}

<style>
    .page-subtitle { color: #64748b; margin: 4px 0 0; font-size: 0.9rem; }

    .stats-row { display: flex; gap: 16px; margin-bottom: 24px; }

    .stat-card {
        background: white; border: 1px solid #e2e8f0; border-radius: 12px;
        padding: 16px 24px; flex: 1; display: flex; align-items: center; gap: 14px;
    }

    .stat-icon {
        width: 42px; height: 42px; border-radius: 10px;
        display: flex; align-items: center; justify-content: center; font-size: 1.1rem;
    }
    .stat-icon.blue   { background: #eff6ff; color: #2563eb; }
    .stat-icon.orange { background: #fff7ed; color: #ea580c; }
    .stat-icon.green  { background: #f0fdf4; color: #16a34a; }

    .stat-info .number { font-size: 1.4rem; font-weight: 700; color: #0f172a; line-height: 1; }
    .stat-info .label  { font-size: 0.78rem; color: #94a3b8; margin-top: 2px; }

    .table-card {
        background: white; border: 1px solid #e2e8f0;
        border-radius: 12px; overflow: hidden;
    }
    .table-card table { margin: 0; }

    .table-card thead th {
        background: #f8fafc; color: #475569; font-size: 0.75rem;
        font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;
        padding: 13px 20px; border-bottom: 1px solid #e2e8f0; border-top: none;
    }

    .table-card tbody td {
        padding: 14px 20px; color: #1e293b; font-size: 0.875rem;
        vertical-align: middle; border-bottom: 1px solid #f1f5f9;
    }
    .table-card tbody tr:last-child td { border-bottom: none; }
    .table-card tbody tr:hover { background: #f8fafc; }

    .codigo { font-weight: 700; font-family: monospace; font-size: 0.85rem; }
    .sub-text { font-size: 0.8rem; color: #94a3b8; margin-top: 2px; }

    .badge-estado {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 4px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 600;
    }
    .badge-emitida    { background: #eff6ff; color: #2563eb; }
    .badge-transito   { background: #fff7ed; color: #ea580c; }
    .badge-completado { background: #f0fdf4; color: #16a34a; }

    .action-btn {
        border: none; padding: 8px 18px; border-radius: 8px;
        font-size: 0.85rem; font-weight: 600; cursor: pointer;
        display: inline-flex; align-items: center; gap: 6px; transition: all 0.15s;
    }
    .btn-iniciar   { background: #2563eb; color: white; }
    .btn-iniciar:hover { background: #1d4ed8; }
    .btn-finalizar { background: #16a34a; color: white; }
    .btn-finalizar:hover { background: #15803d; }
    .btn-disabled  { background: #f1f5f9; color: #94a3b8; cursor: not-allowed; }
</style>

@{
    var emitidas   = Model.Count(o => o.Estado == "Emitida");
    var enTransito = Model.Count(o => o.Estado == "En Tránsito");
    var completadas = Model.Count(o => o.Estado == "Completado");
    var totalGastos = Model.Sum(o => o.Gastos?.Sum(g => g.Monto) ?? 0);
}

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- HEADER -->
<div style="margin-bottom:24px;">
    <h2 style="font-size:1.75rem; font-weight:700; color:#0f172a; margin:0;">Mis Viajes</h2>
    <p class="page-subtitle">Panel del conductor — órdenes asignadas</p>
</div>

<!-- STATS -->
<div class="stats-row">
    <div class="stat-card">
        <div class="stat-icon blue"><i class="fa-regular fa-file-lines"></i></div>
        <div class="stat-info">
            <div class="number">@emitidas</div>
            <div class="label">Pendientes de inicio</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon orange"><i class="fa-solid fa-road"></i></div>
        <div class="stat-info">
            <div class="number">@enTransito</div>
            <div class="label">En tránsito</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon green"><i class="fa-solid fa-circle-check"></i></div>
        <div class="stat-info">
            <div class="number">@completadas</div>
            <div class="label">Completados</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:#f3e8ff; color:#9333ea;">
            <i class="fa-solid fa-file-invoice-dollar"></i>
        </div>
        <div class="stat-info">
            <div class="number">S/ @totalGastos.ToString("0.00")</div>
            <div class="label">Total Gastos</div>
        </div>
    </div>
</div>

<!-- TABLA -->
<div class="table-card">
    @if (!Model.Any())
    {
        <div style="text-align:center; padding:60px; color:#94a3b8;">
            <i class="fa-solid fa-truck" style="font-size:2.5rem; display:block; margin-bottom:12px;"></i>
            <p>No tienes órdenes asignadas aún.</p>
        </div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Orden</th>
                    <th>Cliente</th>
                    <th>Ruta</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var orden in Model)
            {
                string badgeClass = orden.Estado switch {
                    "Emitida"     => "badge-emitida",
                    "En Tránsito" => "badge-transito",
                    "Completado"  => "badge-completado",
                    _ => "badge-emitida"
                };

                <tr>
                    <td><span class="codigo">@orden.Codigo</span></td>
                    <td>@orden.Cliente?.Nombre</td>
                    <td>
                        <div style="font-weight:500;">@orden.Origen</div>
                        <div class="sub-text">
                            <i class="fa-solid fa-arrow-down" style="font-size:0.65rem;"></i> @orden.Destino
                        </div>
                    </td>
                    <td>@orden.FechaEmision.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <span class="badge-estado @badgeClass">
                            <i class="fa-solid fa-circle" style="font-size:0.5rem;"></i>
                            @orden.Estado
                        </span>
                    </td>
                    <td>
                        <div style="display:flex; flex-direction:column; gap:6px;">
                            @if (orden.Estado == "Emitida")
                            {
                                <!-- Botón que abre modal para ingresar datos iniciales -->
                                <button type="button" class="action-btn btn-iniciar" style="width:100%; justify-content:center;" data-bs-toggle="modal" data-bs-target="#iniciarModal" data-ordenid="@orden.Id" data-codigo="@orden.Codigo">
                                    <i class="fa-solid fa-play"></i> Iniciar Ruta
                                </button>
                            }
                            else if (orden.Estado == "En Tránsito")
                            {
                                <div style="display:flex; flex-direction:column; gap:6px;">
                                    <button type="button" class="action-btn btn-finalizar" style="width:100%; justify-content:center;"
                                            data-bs-toggle="modal" data-bs-target="#finalizarModal"
                                            data-ordenid="@orden.Id" data-codigo="@orden.Codigo">
                                        <i class="fa-solid fa-flag-checkered"></i> Finalizar Ruta
                                    </button>
                                    <button type="button"class="action-btn"style="background:#fee2e2; color:#dc2626; width:100%; justify-content:center;"
                                             data-bs-toggle="modal"data-bs-target="#incidenciaModal"
                                             data-ordenid="@orden.Id">
                                        <i class="fa-solid fa-triangle-exclamation"></i> Reportar Incidencia
                                    </button>
                                    <form method="post" asp-action="ReportarUbicacion" asp-route-id="@orden.Id"
                                        style="display:flex; gap:4px;">
                                        @Html.AntiForgeryToken()
                                        <input type="text" name="ciudad" placeholder="Ciudad actual..."
                                            style="border:1px solid #e2e8f0; border-radius:6px; padding:5px 10px; font-size:0.8rem; width:130px;" required />
                                        <button type="submit" class="action-btn" style="background:#eff6ff; color:#2563eb;">
                                            <i class="fa-solid fa-location-dot"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <span class="action-btn btn-disabled" style="width:100%; justify-content:center;">
                                    <i class="fa-solid fa-check"></i> Completado
                                </span>
                            }

                            <a href="@Url.Action("DescargarConstancia", new { id = orden.Id })"
                               class="action-btn" style="background:#f0fdf4; color:#16a34a; text-decoration:none; justify-content:center;">
                                <i class="fa-solid fa-file-arrow-down"></i> Constancia PDF
                            </a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

<!-- Modal: Iniciar Ruta - datos iniciales -->
<div class="modal fade" id="iniciarModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="IniciarRutaConDatos" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ordenId" id="modalOrdenId" />
                <div class="modal-header">
                    <h5 class="modal-title">Datos iniciales de la unidad</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Combustible disponible (galones)</label>
                        <input type="text" inputmode="decimal" name="combustibleInicial" id="combustibleInicial" class="form-control" placeholder="Ej. 45.5" required />
                        <div class="form-text text-danger" id="combustibleError" style="display:none;">Ingrese un número válido >= 0</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Kilometraje actual</label>
                        <input type="text" inputmode="numeric" name="kilometrajeInicial" id="kilometrajeInicial" class="form-control" placeholder="Ej. 120345" required />
                        <div class="form-text text-danger" id="kmError" style="display:none;">Ingrese un número entero válido >= 0</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Observación (opcional)</label>
                        <textarea name="observacion" id="observacion" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Foto (opcional, máx. 5MB)</label>
                        <input type="file" name="fotoInicio" id="fotoInicio" class="form-control" accept="image/*" capture="environment" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" id="modalSubmit" class="btn btn-primary">Iniciar Ruta</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Finalizar Ruta - validación de recepcionista -->
<div class="modal fade" id="finalizarModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="FinalizarRuta" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ordenId" id="finalizarOrdenId" />
                <div class="modal-header">
                    <h5 class="modal-title">Finalizar Ruta</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nombre completo del recepcionista</label>
                        <input type="text" name="recepcionistaNombre" id="recepcionistaNombre" class="form-control"
                               pattern="[A-Za-zÀ-ÿÑñ ]+"
                               oninput="this.value = this.value.replace(/[^A-Za-zÀ-ÿÑñ ]/g, '');"
                               required />
                        <div class="form-text text-danger" id="recepcionistaNombreError" style="display:none;">Ingrese el nombre completo del recepcionista sin números ni símbolos.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">DNI del recepcionista</label>
                        <input type="text" name="recepcionistaDni" id="recepcionistaDni" class="form-control" pattern="\d{8}" required placeholder="Ej. 12345678" />
                        <div class="form-text text-danger" id="recepcionistaDniError" style="display:none;">Ingrese un DNI válido de 8 dígitos.</div>
                    </div>
                    <div class="alert alert-info" role="alert" style="font-size:0.9rem; margin-bottom:0;">
                        Se validará el nombre y DNI del recepcionista con los datos registrados en la solicitud de servicio.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" id="finalizarSubmit" class="btn btn-primary">Finalizar Ruta</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: REPORTAR INCIDENCIA-->
<div class="modal fade" id="incidenciaModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form asp-action="ReportarIncidencia" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" id="incidenciaOrdenId" name="OrdenId" />
                <input type="hidden" id="latitud" name="Latitud" />
                <input type="hidden" id="longitud" name="Longitud" />

                <div class="modal-header">
                    <h5 class="modal-title">
                        Reportar Incidencia
                    </h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">
                            Tipo de Incidencia
                        </label>

                        <select id="tipoIncidencia"
                                name="TipoIncidencia"
                                class="form-control"
                                required>

                            <option value="">
                                Seleccione...
                            </option>

                            <option value="Tráfico">
                                Tráfico
                            </option>

                            <option value="Falla Mecánica">
                                Falla Mecánica
                            </option>

                            <option value="Accidente">
                                Accidente
                            </option>

                            <option value="Otro">
                                Otro
                            </option>

                        </select>
                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Descripción
                        </label>

                        <textarea id="descripcionIncidencia"
                                  name="Descripcion"
                                  class="form-control"
                                  rows="4"
                                  disabled
                                  required></textarea>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-danger">
                        Enviar Alerta
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

<script>
    (function(){
        var iniciarModal = document.getElementById('iniciarModal');
        if(!iniciarModal) return;

        var modalSubmit = document.getElementById('modalSubmit');
        var combustibleInput = document.getElementById('combustibleInicial');
        var kmInput = document.getElementById('kilometrajeInicial');
        var combustibleError = document.getElementById('combustibleError');
        var kmError = document.getElementById('kmError');
        var finalizarModal = document.getElementById('finalizarModal');
        var recepcionistaNombre = document.getElementById('recepcionistaNombre');
        var recepcionistaDni = document.getElementById('recepcionistaDni');
        var recepcionistaNombreError = document.getElementById('recepcionistaNombreError');
        var recepcionistaDniError = document.getElementById('recepcionistaDniError');
        var finalizarSubmit = document.getElementById('finalizarSubmit');

        function isDecimal(value){
            return /^\d+(?:[\.,]\d+)?$/.test(value.trim());
        }
        function isInteger(value){
            return /^\d+$/.test(value.trim());
        }

        function validarModal(){
            var cVal = (combustibleInput.value || '').trim();
            var kmVal = (kmInput.value || '').trim();

            var combustibleValido = isDecimal(cVal) && parseFloat(cVal.replace(',', '.')) >= 0;
            var kmValido = isInteger(kmVal) && parseInt(kmVal, 10) >= 0;

            if(!combustibleValido){
                combustibleError.style.display = 'block';
                combustibleError.textContent = 'Ingrese un número válido >= 0 (solo dígitos y opcionalmente "." o ",")';
            } else {
                combustibleError.style.display = 'none';
            }

            if(!kmValido){
                kmError.style.display = 'block';
                kmError.textContent = 'Ingrese un número entero válido >= 0 (solo dígitos)';
            } else {
                kmError.style.display = 'none';
            }

            modalSubmit.disabled = !(combustibleValido && kmValido);
        }

        function validarFinalizarModal(){
            var nombreVal = (recepcionistaNombre.value || '').trim();
            var dniVal = (recepcionistaDni.value || '').trim();
            var nombreValido = /^[A-Za-zÀ-ÿÑñ ]{3,}$/.test(nombreVal);
            var dniValido = /^\d{8}$/.test(dniVal);

            if(!nombreValido){
                recepcionistaNombreError.style.display = 'block';
            } else {
                recepcionistaNombreError.style.display = 'none';
            }
            if(!dniValido){
                recepcionistaDniError.style.display = 'block';
            } else {
                recepcionistaDniError.style.display = 'none';
            }

            finalizarSubmit.disabled = !(nombreValido && dniValido);
        }

        iniciarModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var ordenId = button.getAttribute('data-ordenid');
            document.getElementById('modalOrdenId').value = ordenId;
            combustibleInput.value = '';
            kmInput.value = '';
            document.getElementById('observacion').value = '';
            document.getElementById('fotoInicio').value = '';
            validarModal();
        });

        if(finalizarModal){
            finalizarModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var ordenId = button.getAttribute('data-ordenid');
                document.getElementById('finalizarOrdenId').value = ordenId;
                recepcionistaNombre.value = '';
                recepcionistaDni.value = '';
                validarFinalizarModal();
            });
            recepcionistaNombre.addEventListener('input', validarFinalizarModal);
            recepcionistaDni.addEventListener('input', validarFinalizarModal);
        }

        combustibleInput.addEventListener('input', validarModal);
        kmInput.addEventListener('input', validarModal);

        validarModal();
        validarFinalizarModal();
    })();

    var incidenciaModal = document.getElementById('incidenciaModal');

if (incidenciaModal) {

    incidenciaModal.addEventListener('show.bs.modal', function (event) {

        var button = event.relatedTarget;

        var ordenId = button.getAttribute('data-ordenid');

        document.getElementById('incidenciaOrdenId').value = ordenId;

        document.getElementById('tipoIncidencia').value = '';
        document.getElementById('descripcionIncidencia').value = '';
        document.getElementById('descripcionIncidencia').disabled = true;

        if (navigator.geolocation) {

            navigator.geolocation.getCurrentPosition(function(position) {

                document.getElementById('latitud').value =
                    position.coords.latitude;

                document.getElementById('longitud').value =
                    position.coords.longitude;

            });

        }

    });

    document.getElementById('tipoIncidencia')
        .addEventListener('change', function() {

            document.getElementById('descripcionIncidencia')
                .disabled = this.value === '';

        });

}
</script>