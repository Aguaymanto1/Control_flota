@using Microsoft.AspNetCore.Identity
@using Control_flota.Models.Login;

@inject SignInManager<Usuario> SignInManager

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FleetOps Pro</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>

<body>

    <div class="layout-wrapper">

        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <aside class="sidebar">
                <div class="sidebar-top">
                    <div class="logo">
                        <i class="fa-solid fa-truck"></i>
                        <span>FleetOps Pro</span>
                    </div>

                    <div class="sidebar-menu">
                        @if (User.IsInRole("Administrador"))
                        {
                            <a class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")"
                            asp-controller="Admin" asp-action="Index">
                                <div class="menu-left"><i class="fa-solid fa-table-cells-large"></i><span>Panel</span></div>
                            </a>
                            <a class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Unidades" ? "active" : "")"
                            asp-controller="Unidades" asp-action="Index">
                                <div class="menu-left"><i class="fa-solid fa-truck"></i><span>Flota</span></div>
                                <div class="badge-menu">3</div>
                            </a>
                            <a class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Conductores" ? "active" : "")"
                            asp-controller="Conductores" asp-action="Index">
                                <div class="menu-left"><i class="fa-regular fa-user"></i><span>Conductores</span></div>
                            </a>
                            <a class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Clientes" ? "active" : "")"
                            asp-controller="Clientes" asp-action="Index">
                                <div class="menu-left"><i class="fa-regular fa-building"></i><span>Clientes</span></div>
                            </a>
                            <a class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Solicitudes" ? "active" : "")"
                            asp-controller="Solicitudes" asp-action="Index">
                                <div class="menu-left"><i class="fa-solid fa-file-lines"></i><span>Solicitudes</span></div>
                            </a>
                            <a class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Ordenes" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                            asp-controller="Ordenes" asp-action="Index">
                                <div class="menu-left"><i class="fa-regular fa-paper-plane"></i><span>Despacho</span></div>
                                <div class="badge-menu">5</div>
                            </a>
                            <a class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "EnDesarrollo" && ViewContext.RouteData.Values["action"]?.ToString() == "Rastreo" ? "active" : "")"
                            asp-controller="EnDesarrollo" asp-action="Rastreo">
                                <div class="menu-left"><i class="fa-solid fa-location-dot"></i><span>Rastreo</span></div>
                            </a>
                            <a class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "EnDesarrollo" && ViewContext.RouteData.Values["action"]?.ToString() == "Finanzas" ? "active" : "")"
                            asp-controller="EnDesarrollo" asp-action="Finanzas">
                                <div class="menu-left"><i class="fa-solid fa-filter"></i><span>Finanzas</span></div>
                                <div class="badge-menu">2</div>
                            </a>
                        }

                        @if (User.IsInRole("Conductor"))
                        {
                            <a class="menu-item @(ViewContext.RouteData.Values["action"]?.ToString() == "PanelConductor" ? "active" : "")"
                            asp-controller="Ordenes" asp-action="PanelConductor">
                                <div class="menu-left"><i class="fa-solid fa-road"></i><span>Mis Viajes</span></div>
                            </a>
                        }
                    </div>
                </div>

                <div class="sidebar-bottom">
                    
                    <div class="menu-item" style="cursor: pointer;">
                        <div class="menu-left">
                            <i class="fa-regular fa-bell"></i>
                            <span>Notificaciones</span>
                        </div>
                    </div>
                    <div class="menu-item" style="cursor: pointer;">
                        <div class="menu-left">
                            <i class="fa-solid fa-gear"></i>
                            <span>Configuración</span>
                        </div>
                    </div>
                    <!-- Usuario y logout -->
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <div style="padding: 10px 16px; border-top: 1px solid #e2e8f0; margin-bottom: 4px;">
                            <div style="font-size:0.75rem; color:#94a3b8; margin-bottom:2px;">Sesión activa</div>
                            <div style="font-size:0.82rem; font-weight:600; color:#1e293b; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                @User.Identity.Name
                            </div>
                        </div>
                        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post" style="margin:0;">
                            <button type="submit" class="menu-item" style="width:100%; background:none; border:none; text-align:left; cursor:pointer; color:#dc2626;">
                                <div class="menu-left">
                                    <i class="fa-solid fa-right-from-bracket"></i>
                                    <span>Cerrar sesión</span>
                                </div>
                            </button>
                        </form>
                    }
                </div>

            </aside>
        }

        <div class="main-content">
            
            <div class="workspace-container">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>

            <footer class="py-3 text-center text-muted bg-white border-top mt-auto">
                <small>&copy; 2026 - FleetOps Pro - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none">Privacidad</a></small>
            </footer>

        </div>
    </div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>