@model IEnumerable<Control_flota.Models.Operaciones.SolicitudServicio>
@{
    ViewData["Title"] = "Solicitudes de Servicio";
}

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .page-subtitle { color: #64748b; margin: 0; font-size: 0.9rem; }

    .header-actions { display: flex; gap: 10px; }

    .btn-primary-custom {
        background-color: #2563eb;
        color: white;
        border: none;
        padding: 9px 18px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.875rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        transition: background 0.2s;
    }
    .btn-primary-custom:hover { background-color: #1d4ed8; color: white; }

    .btn-secondary-custom {
        background-color: #f1f5f9;
        color: #475569;
        border: none;
        padding: 9px 18px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.875rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        transition: background 0.2s;
    }
    .btn-secondary-custom:hover { background-color: #e2e8f0; color: #1e293b; }

    .btn-success-custom {
        background-color: #16a34a;
        color: white;
        border: none;
        padding: 9px 18px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.875rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        transition: background 0.2s;
    }
    .btn-success-custom:hover { background-color: #15803d; color: white; }

    .stats-row { display: flex; gap: 16px; margin-bottom: 24px; }

    .stat-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 16px 24px;
        flex: 1;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .stat-icon {
        width: 42px; height: 42px;
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.1rem;
    }
    .stat-icon.blue   { background: #eff6ff; color: #2563eb; }
    .stat-icon.orange { background: #fff7ed; color: #ea580c; }
    .stat-icon.green  { background: #f0fdf4; color: #16a34a; }
    .stat-icon.gray   { background: #f1f5f9; color: #64748b; }

    .stat-info .number { font-size: 1.4rem; font-weight: 700; color: #0f172a; line-height: 1; }
    .stat-info .label  { font-size: 0.78rem; color: #94a3b8; margin-top: 2px; }

    .toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
        gap: 10px;
    }

    .search-bar { display: flex; gap: 8px; }
    .search-bar input {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 8px 14px;
        font-size: 0.875rem;
        width: 240px;
        outline: none;
    }
    .search-bar input:focus { border-color: #2563eb; }

    .table-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
    }

    .table-card table { margin: 0; }

    .table-card thead th {
        background: #f8fafc;
        color: #475569;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 13px 20px;
        border-bottom: 1px solid #e2e8f0;
        border-top: none;
    }

    .table-card tbody td {
        padding: 13px 20px;
        color: #1e293b;
        font-size: 0.875rem;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
    }

    .table-card tbody tr:last-child td { border-bottom: none; }
    .table-card tbody tr:hover { background: #f8fafc; }

    .codigo { font-weight: 700; color: #0f172a; font-family: monospace; font-size: 0.85rem; }
    .ruta-sub { font-size: 0.8rem; color: #94a3b8; margin-top: 2px; }

    .badge-estado {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 4px 10px; border-radius: 20px;
        font-size: 0.75rem; font-weight: 600;
    }
    .badge-emitida     { background: #f0fdf4; color: #16a34a; }
    .badge-noemitida   { background: #f1f5f9; color: #64748b; }
    .badge-asignado    { background: #eff6ff; color: #2563eb; }
    .badge-pendiente   { background: #fff7ed; color: #ea580c; }

    .action-btn {
        border: none; padding: 5px 12px; border-radius: 6px;
        font-size: 0.78rem; font-weight: 600; cursor: pointer;
        text-decoration: none; display: inline-flex; align-items: center;
        gap: 4px; transition: all 0.15s;
    }
    .action-btn.assign  { background: #eff6ff; color: #2563eb; }
    .action-btn.assign:hover { background: #dbeafe; }
    .action-btn.view    { background: #f1f5f9; color: #475569; }
    .action-btn.view:hover { background: #e2e8f0; }
    .action-btn.delete  { background: #fef2f2; color: #dc2626; }
    .action-btn.delete:hover { background: #fee2e2; }
</style>

@{
    var total     = Model.Count();
    var pendientes = Model.Count(s => s.EstadoSolicitud == "Pendiente" || s.EstadoSolicitud == "Pendiente de Asignación");
    var asignados  = Model.Count(s => s.EstadoSolicitud == "Asignado");
    var ids        = ViewBag.OrdenesEmitidasIds as HashSet<int>;
    var emitidas   = ids?.Count ?? 0;
}

<!-- HEADER -->
<div class="page-header">
    <div>
        <h2 style="font-size:1.75rem; font-weight:700; color:#0f172a; margin:0;">Solicitudes de Servicio</h2>
        <p class="page-subtitle">Gestión de solicitudes y asignaciones</p>
    </div>
    <div class="header-actions">
        <a href="@Url.Action("Index", "Ordenes")" class="btn-secondary-custom">
            <i class="fa-regular fa-paper-plane"></i> Centro de Despacho
        </a>
        <a href="@Url.Action("RegistrarCliente", "Clientes")" class="btn-secondary-custom">
            <i class="fa-solid fa-building"></i> Nuevo Cliente
        </a>
        <button type="button" class="btn-success-custom"
                data-bs-toggle="modal" data-bs-target="#nuevaSolicitudModal">
            <i class="fa-solid fa-plus"></i> Nueva Solicitud
        </button>
    </div>
</div>

<!-- STATS -->
<div class="stats-row">
    <div class="stat-card">
        <div class="stat-icon blue"><i class="fa-regular fa-file-lines"></i></div>
        <div class="stat-info">
            <div class="number">@total</div>
            <div class="label">Total solicitudes</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon orange"><i class="fa-solid fa-clock"></i></div>
        <div class="stat-info">
            <div class="number">@pendientes</div>
            <div class="label">Pendientes</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon blue"><i class="fa-solid fa-truck"></i></div>
        <div class="stat-info">
            <div class="number">@asignados</div>
            <div class="label">Asignados</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon green"><i class="fa-solid fa-file-circle-check"></i></div>
        <div class="stat-info">
            <div class="number">@emitidas</div>
            <div class="label">Con orden emitida</div>
        </div>
    </div>
</div>

<!-- TABLA -->
<div class="table-card">
    @if (!Model.Any())
    {
        <div style="text-align:center; padding:60px; color:#94a3b8;">
            <i class="fa-regular fa-file-lines" style="font-size:2.5rem; display:block; margin-bottom:12px;"></i>
            <p>No hay solicitudes registradas.</p>
        </div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Cliente</th>
                    <th>Ruta</th>
                    <th>Conductor / Placa</th>
                    <th>Orden</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var solicitud in Model)
            {
                bool tieneOrden = ids != null && ids.Contains(solicitud.Id);
                string estadoClass = solicitud.EstadoSolicitud switch {
                    "Asignado" => "badge-asignado",
                    "Pendiente" => "badge-pendiente",
                    "Pendiente de Asignación" => "badge-pendiente",
                    _ => "badge-pendiente"
                };

                <tr>
                    <td><span class="codigo">@solicitud.Codigo</span></td>
                    <td>@(solicitud.Cliente?.Nombre ?? "-")</td>
                    <td>
                        <div style="font-weight:500;">@solicitud.Origen</div>
                        <div class="ruta-sub"><i class="fa-solid fa-arrow-down" style="font-size:0.65rem;"></i> @solicitud.Destino</div>
                    </td>
                    <td>
                        <div>@(solicitud.Conductor != null ? solicitud.Conductor.Nombres + " " + solicitud.Conductor.Apellidos : "-")</div>
                        <div class="ruta-sub">@(solicitud.Unidad != null ? solicitud.Unidad.Placa : "-")</div>
                    </td>
                    <td>
                        @if (tieneOrden)
                        {
                            <span class="badge-estado badge-emitida">
                                <i class="fa-solid fa-circle" style="font-size:0.5rem;"></i> Emitida
                            </span>
                        }
                        else
                        {
                            <span class="badge-estado badge-noemitida">
                                <i class="fa-solid fa-circle" style="font-size:0.5rem;"></i> No emitida
                            </span>
                        }
                    </td>
                    <td>
                        <span class="badge-estado @estadoClass">
                            <i class="fa-solid fa-circle" style="font-size:0.5rem;"></i>
                            @solicitud.EstadoSolicitud
                        </span>
                    </td>
                    <td>
                        <div style="display:flex; gap:6px; flex-wrap:wrap;">
                            @if (solicitud.EstadoSolicitud != "Asignado")
                            {
                                <a asp-action="AsignarFlota" asp-route-id="@solicitud.Id" class="action-btn assign">
                                    <i class="fa-solid fa-truck"></i> Asignar
                                </a>
                            }
                            <a href="@Url.Action("Details", new { id = solicitud.Id })" class="action-btn view">
                                <i class="fa-regular fa-eye"></i> Ver
                            </a>
                            <form method="post" asp-action="Eliminar" asp-route-id="@solicitud.Id" style="display:inline;"
                                  onsubmit="return confirm('¿Eliminar esta solicitud?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="action-btn delete">
                                    <i class="fa-regular fa-trash-can"></i> Eliminar
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

<!-- MODAL NUEVA SOLICITUD -->
<div class="modal fade" id="nuevaSolicitudModal" tabindex="-1" aria-labelledby="nuevaSolicitudModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="border-radius:16px; border:none;">
            <div class="modal-header" style="border-bottom:1px solid #e2e8f0; padding:20px 24px;">
                <h5 class="modal-title" style="font-weight:700; color:#0f172a;">
                    <i class="fa-solid fa-plus me-2" style="color:#2563eb;"></i>Nueva Solicitud de Servicio
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-controller="Solicitudes" asp-action="RegistrarServicio">
                <div class="modal-body" style="padding:24px;">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Cliente</label>
                        <select name="ClienteId" class="form-control" required>
                            <option value="">Seleccione un cliente</option>
                            @foreach (var cliente in ViewBag.Clientes)
                            {
                                <option value="@cliente.Id">@cliente.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Origen</label>
                            <input type="text" name="Origen" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Destino</label>
                            <input type="text" name="Destino" class="form-control" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Peso (Kg)</label>
                            <input type="number" step="0.01" name="PesoKg" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Tipo de Carga</label>
                            <select name="TipoCarga" class="form-control" required>
                                <option value="">Seleccione el tipo</option>
                                @foreach (var tipo in ViewBag.TipoCargaOptions)
                                {
                                    <option value="@tipo">@tipo</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="border-top:1px solid #e2e8f0; padding:16px 24px;">
                    <button type="button" class="btn-secondary-custom" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn-success-custom">
                        <i class="fa-solid fa-check"></i> Guardar Solicitud
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>