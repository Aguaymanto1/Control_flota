@{
    ViewData["Title"] = "Consultar Carga";
    Layout = "_Layout";
}

<style>
    .rastreo-wrap {
        max-width: 680px;
        margin: 0 auto;
        padding: 20px 0;
        transition: max-width 0.3s ease;
    }

    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrador"))
    {
        <text>
        .rastreo-wrap {
            max-width: 1000px !important;
        }
        </text>
    }

    .search-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 32px;
        margin-bottom: 24px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.02);
    }

    .search-card h2 {
        font-size: 1.5rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 6px;
    }

    .search-card p {
        color: #64748b;
        font-size: 0.9rem;
        margin-bottom: 20px;
    }

    .input-group-custom {
        display: flex;
        gap: 10px;
    }

    .input-group-custom input {
        flex: 1;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 10px 16px;
        font-size: 0.95rem;
        outline: none;
        text-transform: uppercase;
    }

    .input-group-custom input:focus {
        border-color: #2563eb;
    }

    .btn-consultar {
        background: #2563eb;
        color: white;
        border: none;
        padding: 10px 24px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: background 0.2s;
    }

    .btn-consultar:hover { background: #1d4ed8; }

    .result-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.02);
    }

    .result-header {
        background: #0f172a;
        color: white;
        padding: 20px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .result-header .codigo {
        font-family: monospace;
        font-size: 1.1rem;
        font-weight: 700;
    }

    .badge-estado {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .badge-emitida    { background: #eff6ff; color: #2563eb; }
    .badge-transito   { background: #fff7ed; color: #ea580c; }
    .badge-completado { background: #f0fdf4; color: #16a34a; }
    .badge-pendiente  { background: #f1f5f9; color: #64748b; }
    .badge-asignado   { background: #eff6ff; color: #2563eb; }

    .result-body {
        padding: 24px;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.9rem;
    }

    .info-row:last-child { border-bottom: none; }
    .info-row .label { color: #64748b; }
    .info-row .valor { font-weight: 600; color: #0f172a; }

    .ubicacion-card {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 10px;
        padding: 16px;
        margin-top: 16px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .ubicacion-card i {
        color: #2563eb;
        font-size: 1.4rem;
    }

    .timeline {
        margin-top: 20px;
    }

    .timeline-item {
        display: flex;
        gap: 12px;
        margin-bottom: 12px;
        align-items: flex-start;
    }

    .timeline-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        margin-top: 4px;
        flex-shrink: 0;
    }

    .dot-done  { background: #16a34a; }
    .dot-active { background: #2563eb; }
    .dot-pending { background: #e2e8f0; }

    .timeline-line {
        width: 2px;
        height: 20px;
        background: #e2e8f0;
        margin-left: 4px;
        margin-bottom: 0;
    }

    .error-card {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 12px;
        padding: 24px;
        text-align: center;
        color: #dc2626;
    }

    /* Estilos Premium para Pestañas */
    .nav-tabs .nav-link {
        border: none !important;
        border-bottom: 2px solid transparent !important;
        background: none !important;
        color: #64748b !important;
        font-weight: 600;
        padding: 12px 20px;
        transition: all 0.2s ease;
    }
    .nav-tabs .nav-link:hover {
        color: #2563eb !important;
        border-bottom-color: #cbd5e1 !important;
    }
    .nav-tabs .nav-link.active {
        color: #2563eb !important;
        border-bottom: 2px solid #2563eb !important;
    }
</style>

<div class="rastreo-wrap">

    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrador"))
    {
        <!-- PESTAÑAS PARA EL ADMINISTRADOR -->
        <ul class="nav nav-tabs mb-4" id="trackingTabs" role="tablist" style="border-bottom: 2px solid #e2e8f0;">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="consulta-tab" data-bs-toggle="tab" data-bs-target="#consulta-pane" type="button" role="tab" aria-controls="consulta-pane" aria-selected="true">
                    <i class="fa-solid fa-magnifying-glass me-2"></i>Consulta de Carga
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="mapa-tab" data-bs-toggle="tab" data-bs-target="#mapa-pane" type="button" role="tab" aria-controls="mapa-pane" aria-selected="false" onclick="clickMapaTab()">
                    <i class="fa-solid fa-map-location-dot me-2"></i>Mapa de Flota
                </button>
            </li>
        </ul>

        <div class="tab-content" id="trackingTabsContent">
            <!-- PANEL: CONSULTA INDIVIDUAL -->
            <div class="tab-pane fade show active" id="consulta-pane" role="tabpanel" aria-labelledby="consulta-tab">
                <partial name="_BuscadorYResultados" />
            </div>

            <!-- PANEL: MAPA GENERAL -->
            <div class="tab-pane fade" id="mapa-pane" role="tabpanel" aria-labelledby="mapa-tab">
                <div class="search-card" style="padding: 24px; margin-bottom: 20px;">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div>
                            <h2 style="margin-bottom: 4px;"><i class="fa-solid fa-map-location-dot me-2" style="color:#2563eb;"></i>Monitoreo de Flota en Tiempo Real</h2>
                            <p style="margin-bottom: 0;">Ubicación estimada de las unidades actualmente en ruta.</p>
                        </div>
                        <span class="badge bg-secondary px-3 py-2" id="contador-unidades" style="border-radius: 20px; font-size: 0.85rem; font-weight: 600;">
                            0 Unidades Activas
                        </span>
                    </div>

                    <div id="tracking-map" style="height: 500px; width: 100%; border-radius: 12px; border: 1px solid #cbd5e1; background-color: #e2e8f0; position: relative;">
                        <!-- Loader del Mapa -->
                        <div id="map-loader" class="d-flex flex-column justify-content-center align-items-center" style="position: absolute; top:0; left:0; width:100%; height:100%; background: rgba(248, 250, 252, 0.8); z-index: 10; border-radius: 12px;">
                            <div class="spinner-border text-primary mb-2" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <span class="text-muted fw-bold">Inicializando mapa de Google...</span>
                        </div>
                    </div>

                    <!-- Leyenda -->
                    <div class="d-flex gap-4 mt-3 p-3 bg-light rounded flex-wrap" style="font-size: 0.85rem; border: 1px solid #e2e8f0;">
                        <div class="d-flex align-items-center gap-2">
                            <img src="https://maps.google.com/mapfiles/ms/icons/green-dot.png" height="24" alt="Pin Verde" />
                            <span class="fw-bold" style="color: #334155;">Pin Verde:</span>
                            <span class="text-muted">Unidad transitando a tiempo (Normal)</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <img src="https://maps.google.com/mapfiles/ms/icons/red-dot.png" height="24" alt="Pin Rojo" />
                            <span class="fw-bold" style="color: #334155;">Pin Rojo:</span>
                            <span class="text-muted">Unidad con incidencia reportada</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- VISTA DE CONSULTA PÚBLICA (SIN PESTAÑAS) -->
        <partial name="_BuscadorYResultados" />
    }

</div>

@section Scripts {
    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrador"))
    {
        <!-- Cargar API de Google Maps de forma asíncrona -->
        <script src="https://maps.googleapis.com/maps/api/js?key=" async defer></script>
        <script>
            let map;
            let markers = {};
            let mapInitialized = false;
            let updateInterval;

            function clickMapaTab() {
                // Dar un breve retraso para que Bootstrap renderice el panel y calcule correctamente el tamaño del div
                setTimeout(initTrackingMap, 200);
            }

            function initTrackingMap() {
                if (mapInitialized) {
                    if (map && typeof google !== 'undefined' && google.maps) {
                        google.maps.event.trigger(map, 'resize');
                    }
                    return;
                }

                const loader = document.getElementById('map-loader');

                if (typeof google === 'undefined' || !google.maps) {
                    document.getElementById('tracking-map').innerHTML = `
                        <div class="d-flex flex-column justify-content-center align-items-center h-100 p-4 text-center" style="background:#f8fafc; border-radius:12px;">
                            <i class="fa-solid fa-triangle-exclamation text-warning mb-3" style="font-size:3rem;"></i>
                            <h5 class="fw-bold text-dark">La API de Google Maps no se pudo cargar</h5>
                            <p class="text-muted" style="max-width:400px; font-size:0.9rem; margin-bottom:15px;">
                                Asegúrate de estar conectado a Internet para inicializar el mapa. Si no tienes una clave de API configurada, cargará en modo de desarrollo.
                            </p>
                            <button class="btn btn-primary btn-sm" onclick="location.reload()">
                                <i class="fa-solid fa-rotate-right me-1"></i> Recargar
                            </button>
                        </div>
                    `;
                    return;
                }

                // Centrado en el Perú
                const centroPeru = { lat: -9.5, lng: -76.0 };

                const mapOptions = {
                    zoom: 6,
                    center: centroPeru,
                    mapTypeControl: false,
                    streetViewControl: false,
                    fullscreenControl: true,
                    zoomControl: true,
                    styles: [
                        { "featureType": "administrative", "elementType": "labels.text.fill", "color": "#444444" },
                        { "featureType": "landscape", "elementType": "all", "color": "#f2f2f2" },
                        { "featureType": "poi", "elementType": "all", "visibility": "off" },
                        { "featureType": "road", "elementType": "all", "saturation": -100, "lightness": 45 },
                        { "featureType": "road.highway", "elementType": "all", "visibility": "simplified" },
                        { "featureType": "road.arterial", "elementType": "labels.icon", "visibility": "off" },
                        { "featureType": "transit", "elementType": "all", "visibility": "off" },
                        { "featureType": "water", "elementType": "all", "color": "#cbd5e1" }
                    ]
                };

                map = new google.maps.Map(document.getElementById('tracking-map'), mapOptions);
                mapInitialized = true;
                if (loader) loader.style.display = 'none';

                cargarDatosFlota();

                if (updateInterval) clearInterval(updateInterval);
                updateInterval = setInterval(cargarDatosFlota, 10000);
            }

            function cargarDatosFlota() {
                fetch('/Rastreo/ObtenerFlotaActiva')
                    .then(response => response.json())
                    .then(data => {
                        actualizarMarcadores(data);
                    })
                    .catch(error => {
                        console.error('Error al obtener datos de la flota:', error);
                    });
            }

            function actualizarMarcadores(flota) {
                const activeIds = new Set();
                let totalActivas = 0;

                flota.forEach(camion => {
                    activeIds.add(camion.id);
                    totalActivas++;

                    const pos = { lat: parseFloat(camion.latitud), lng: parseFloat(camion.longitud) };
                    const pinUrl = camion.tieneIncidencia 
                        ? 'https://maps.google.com/mapfiles/ms/icons/red-dot.png'
                        : 'https://maps.google.com/mapfiles/ms/icons/green-dot.png';

                    if (markers[camion.id]) {
                        markers[camion.id].setPosition(pos);
                    } else {
                        const marker = new google.maps.Marker({
                            position: pos,
                            map: map,
                            title: camion.placa,
                            icon: pinUrl,
                            animation: google.maps.Animation.DROP
                        });

                        const contentString = `
                            <div style="padding: 10px; font-family: 'Inter', sans-serif; max-width: 220px; line-height: 1.4;">
                                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; border-bottom:1px solid #e2e8f0; padding-bottom:4px;">
                                    <span style="font-weight:700; color:#0f172a; font-size:0.95rem;">🚚 ${camion.placa}</span>
                                    <span style="font-size:0.7rem; font-weight:700; padding:2px 8px; border-radius:10px; background:${camion.tieneIncidencia ? '#fef2f2' : '#f0fdf4'}; color:${camion.tieneIncidencia ? '#dc2626' : '#16a34a'};">
                                        ${camion.tieneIncidencia ? 'Incidencia' : 'En Ruta'}
                                    </span>
                                </div>
                                <div style="font-size:0.75rem; color:#64748b; margin-bottom:1px;">Conductor:</div>
                                <div style="font-size:0.85rem; font-weight:600; color:#1e293b; margin-bottom:6px;">${camion.conductor}</div>
                                
                                <div style="font-size:0.75rem; color:#64748b; margin-bottom:1px;">Ruta:</div>
                                <div style="font-size:0.85rem; font-weight:600; color:#1e293b; margin-bottom:6px;">
                                    ${camion.origen} ➔ ${camion.destino}
                                </div>

                                <div style="font-size:0.75rem; color:#64748b; margin-bottom:1px;">Última posición:</div>
                                <div style="font-size:0.85rem; font-weight:600; color:#2563eb;">
                                    📍 ${camion.ultimaCiudad}
                                </div>
                            </div>
                        `;

                        const infowindow = new google.maps.InfoWindow({
                            content: contentString
                        });

                        marker.addListener('click', () => {
                            if (window.currentInfoWindow) {
                                window.currentInfoWindow.close();
                            }
                            infowindow.open(map, marker);
                            window.currentInfoWindow = infowindow;
                        });

                        markers[camion.id] = marker;
                    }
                });

                // Remover los que ya no están activos
                for (const id in markers) {
                    if (!activeIds.has(parseInt(id))) {
                        markers[id].setMap(null);
                        delete markers[id];
                    }
                }

                // Actualizar contador
                const contador = document.getElementById('contador-unidades');
                if (contador) {
                    contador.innerText = `${totalActivas} Unidad${totalActivas === 1 ? '' : 'es'} Activa${totalActivas === 1 ? '' : 's'}`;
                    if (totalActivas > 0) {
                        contador.className = "badge bg-success px-3 py-2";
                    } else {
                        contador.className = "badge bg-secondary px-3 py-2";
                    }
                }
            }

            window.addEventListener('beforeunload', () => {
                if (updateInterval) clearInterval(updateInterval);
            });
        </script>
    }
}